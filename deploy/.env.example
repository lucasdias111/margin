# margin instance configuration. install.sh writes this file for you;
# this copy documents every setting. Restart with `docker compose up -d`
# after changing it.

# ── Required ────────────────────────────────────────────────
# The domain users reach the instance at. Point its A record at PUBLIC_IP.
DOMAIN=chat.example.com
# The host's public IPv4 address, announced for calls (SFU and TURN).
PUBLIC_IP=203.0.113.10
# The release to run. Upgrade by changing it, then `docker compose pull && docker compose up -d`.
MARGIN_VERSION=1.0.0

# ── Secrets (generated by install.sh) ───────────────────────
# Changing JWT_SECRET signs everyone out. POSTGRES_PASSWORD is fixed once the
# database exists.
POSTGRES_PASSWORD=
JWT_SECRET=
MEETING_GUEST_TOKEN_SECRET=
SFU_SECRET=
INTERNAL_API_KEY=
TURN_SECRET=

# ── First admin (optional) ──────────────────────────────────
# Without these, the server logs a one-time setup link; `docker compose exec
# margin-server margin setup-link` prints it again.
# MARGIN_ADMIN_EMAIL=
# MARGIN_ADMIN_PASSWORD=

# ── Mail (optional) ─────────────────────────────────────────
# Without SMTP, password resets go through an admin and email verification is off.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@chat.example.com

# ── File storage (optional) ─────────────────────────────────
# local keeps uploads in the `uploads` volume; s3 uses any S3-compatible store.
# STORAGE_TYPE=local
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=margin
# S3_REGION=eu-central
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Largest upload accepted, in Spring units (50MB = 50 MiB).
# MAX_UPLOAD_SIZE=50MB

# ── Features (optional) ─────────────────────────────────────
# A KLIPY API key turns on the GIF picker.
# KLIPY_API_KEY=
# Check GitHub daily for a newer release and tell admins.
# UPDATE_CHECK=true

# ── Calls (optional) ────────────────────────────────────────
# Override the TURN/STUN URIs handed to clients, comma-separated. By default
# they are turn:DOMAIN:3478 (udp and tcp) and stun:DOMAIN:3478.
# TURN_URIS=

# ── Bring your own proxy (optional) ─────────────────────────
# Set BEHIND_PROXY=true when your own proxy terminates TLS. margin-web then
# serves plain HTTP; bind it to localhost and point your proxy at HTTP_PORT.
# BEHIND_PROXY=false
# HTTP_PORT=127.0.0.1:8080
# HTTPS_PORT=127.0.0.1:8443
# The server trusts X-Forwarded-For from private addresses. If your proxy
# reaches it from a public address, match that address here (a regular expression).
# TRUSTED_PROXIES=

# ── Native push (optional, custom native builds only) ───────
# Web Push needs no setup. Put key files in ./secrets.
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
# APNS_KEY_FILE=/run/secrets/apns-key.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_PRODUCTION=false
