# ── Hetzner ──────────────────────────────
HETZNER_PUBLIC_IP=135.181.100.126

# ── Domain ───────────────────────────────
DOMAIN=margin.chat
ADMIN_EMAIL=you@yourdomain.com

# ── App versions ─────────────────────────
SERVER_VERSION=0.0.1-SNAPSHOT
SFU_VERSION=1.0.0

# ── PostgreSQL ───────────────────────────
POSTGRES_DB=margindb
POSTGRES_USER=margin
POSTGRES_PASSWORD=changeme_strong_password

# ── JWT ──────────────────────────────────
JWT_SECRET=changeme_very_long_random_secret_min_32_chars
MEETING_GUEST_TOKEN_SECRET=changeme_separate_secret_for_meeting_guest_tokens

# ── SFU ──────────────────────────────────
# Shared between margin-server and margin-mediasoup -- must match
SFU_SECRET=changeme_sfu_token_secret
INTERNAL_API_KEY=changeme_internal_api_key
# Browser origins allowed to open a media WebSocket, comma-separated.
# Empty means allow any. Native mobile clients send no Origin and are always allowed.
SFU_ALLOWED_ORIGINS=https://margin.chat
# How long a room may sit empty before its mediasoup router is closed (ms).
SFU_ROOM_IDLE_MS=300000

# ── Storage (Hetzner Object Storage) ─────
STORAGE_TYPE=s3
HETZNER_S3_ENDPOINT=changeme_hetzner_s3_endpoint
S3_ACCESS_KEY=changeme_s3_access_key
S3_SECRET_KEY=changeme_s3_secret_key

# ── Backups ───────────────────────────────
# Hetzner Object Storage bucket for pg_dump backups (create a separate bucket)
BACKUP_BUCKET=changeme_backup_bucket_name

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
STMP_PASSWORD=

UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=

# ── Grafana ──────────────────────────────
# Login for https://grafana.${DOMAIN}
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_admin_password
# Read-only DB roles the dashboards query through. Create them with
# grafana/sql/margindb-grafana-readonly.sql and
# grafana/sql/umami-grafana-readonly.sql, using these passwords.
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=changeme_grafana_margindb_password
GRAFANA_UMAMI_DB_PASSWORD=changeme_grafana_umami_password
# Mobile push notifications (optional — leave unset to disable)
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
# APNS_KEY_FILE=/run/secrets/apns-key.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=margin.mobile.ios
# APNS_PRODUCTION=false
