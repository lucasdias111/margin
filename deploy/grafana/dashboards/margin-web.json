    {
      "id": 11,
      "type": "table",
      "title": "Top entry pages",
      "description": "The first page of each visit -- where traffic actually lands, which is not always the home page.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "umami"
