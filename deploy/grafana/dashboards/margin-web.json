        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, $__interval, 0),\n       count(DISTINCT session_id) AS \"Visitors\"\nFROM website_event WHERE website_id = '$website'::uuid AND event_type = 1 AND $__timeFilter(created_at)\nGROUP BY 1 ORDER BY 1",
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "umami"
          }
        },
        {
          "refId": "B",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, $__interval, 0),\n       count(DISTINCT visit_id) AS \"Visits\"\nFROM website_event WHERE website_id = '$website'::uuid AND event_type = 1 AND $__timeFilter(created_at)\nGROUP BY 1 ORDER BY 1",
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "umami"
          }
        },
        {
          "refId": "C",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, $__interval, 0),\n       count(*) AS \"Pageviews\"\nFROM website_event WHERE website_id = '$website'::uuid AND event_type = 1 AND $__timeFilter(created_at)\nGROUP BY 1 ORDER BY 1",
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "umami"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum",
            "mean"
