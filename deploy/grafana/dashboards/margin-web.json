    {
      "id": 6,
      "type": "stat",
      "title": "Bounce rate",
      "description": "Visits that saw exactly one page. On a landing page a high number is normal; watch the trend, not the value.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "umami"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE views = 1)\n             / nullif(count(*), 0), 1) AS \"Bounce rate\"\nFROM (\n  SELECT visit_id, count(*) AS views\n  FROM website_event WHERE website_id = '$website'::uuid AND event_type = 1 AND $__timeFilter(created_at)\n  GROUP BY visit_id\n) v",
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "umami"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Avg visit duration",
      "description": "Bounced visits count as 0 seconds -- there is no second event to measure against.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "umami"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(CAST(avg(secs) AS numeric), 0) AS \"Avg duration\"\nFROM (\n  SELECT visit_id,\n         extract(epoch FROM (max(created_at) - min(created_at))) AS secs\n  FROM website_event WHERE website_id = '$website'::uuid AND event_type = 1 AND $__timeFilter(created_at)\n  GROUP BY visit_id\n) v",
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "umami"
          }
        }
      ],
      "options": {
        "reduceOptions": {
