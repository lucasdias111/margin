    {
      "id": 24,
      "type": "barchart",
      "title": "Landing funnel (visitors per step)",
      "description": "Steps are independent counts, not a strict path -- somebody can hit /download without ever seeing /pricing. /activate is the e-mail confirmation landing, so it tracks completed signups.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "umami"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 47
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH v AS (\n  SELECT url_path, session_id FROM website_event WHERE website_id = '$website'::uuid AND event_type = 1 AND $__timeFilter(created_at)\n)\nSELECT '1. Home' AS \"Step\", count(DISTINCT session_id) AS \"Visitors\"\nFROM v WHERE url_path = '/'\nUNION ALL\nSELECT '2. Pricing', count(DISTINCT session_id)\nFROM v WHERE url_path LIKE '/pricing%'\nUNION ALL\nSELECT '3. Download', count(DISTINCT session_id)\nFROM v WHERE url_path LIKE '/download%'\nUNION ALL\nSELECT '4. Activate', count(DISTINCT session_id)\nFROM v WHERE url_path LIKE '/activate%'\nORDER BY 1",
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "umami"
          }
        }
      ],
