        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT session_id) AS \"Visitors\"\nFROM website_event WHERE website_id = '$website'::uuid AND event_type = 1 AND $__timeFilter(created_at)",
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "umami"
          }
        }
      ],
      "options": {
