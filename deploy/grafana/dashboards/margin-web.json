          "rawSql": "SELECT url_path AS \"Page\",\n       count(*) AS \"Views\",\n       count(DISTINCT session_id) AS \"Visitors\"\nFROM website_event WHERE website_id = '$website'::uuid AND event_type = 1 AND $__timeFilter(created_at)\nGROUP BY url_path ORDER BY 2 DESC LIMIT 25",
