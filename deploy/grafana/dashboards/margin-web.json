        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT url_path AS \"Entry page\", count(*) AS \"Visits\"\nFROM (\n  SELECT DISTINCT ON (visit_id) visit_id, url_path\n  FROM website_event WHERE website_id = '$website'::uuid AND event_type = 1 AND $__timeFilter(created_at)\n  ORDER BY visit_id, created_at\n) e\nGROUP BY url_path ORDER BY 2 DESC LIMIT 25",
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "umami"
