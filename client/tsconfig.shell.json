{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["src/shell/src/**/*", "src/shell/src/**/*.svelte", "src/common/**/*"],
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "strict": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  }
}
